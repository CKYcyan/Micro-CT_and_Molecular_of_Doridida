begin mrbayes;
    outgroup C057;
    
    lset nst=6 nucmodel=4by4 rates=invgamma;
    
    prset statefreqpr=dirichlet(0.25,0.25,0.25,0.25);
    prset revmatpr=dirichlet(1.00,1.00,1.00,1.00,1.00,1.00);
    prset shapepr=exponential(1.00);
    prset pinvarpr=uniform(0.00,1.00);
    prset topologypr=uniform;
    prset ratepr=fixed;
    prset brlenspr=unconstrained:exponential(10.00);
    
    set seed=933430731;
    set swapseed=1725720201;
    
    mcmc ngen=40000000 nruns=2 nchains=4 temp=0.2 swapfreq=1 nswaps=1 samplefreq=1000 printfreq=1000 mcmcdiagn=yes diagnfreq=5000 minpartfreq=0.10 append=yes;
    
    sump burnin=0.25 nruns=2;
    sumt burnin=0.25 nruns=2 contype=halfcompat;
end;